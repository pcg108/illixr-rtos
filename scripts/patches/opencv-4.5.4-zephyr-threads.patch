+#elif defined(__ZEPHYR__)
+// POSIX keys only accept pthread-created threads in this Zephyr revision.
+static thread_local void* zephyr_tls_data = nullptr;
+TlsAbstraction::TlsAbstraction() : disposed(false) {}
+void TlsAbstraction::releaseSystemResources()
+{
+    cv::__termination = true;
+    disposed = true;
+}
+void* TlsAbstraction::getData() const
+{
+    return disposed ? nullptr : zephyr_tls_data;
+}
+void TlsAbstraction::setData(void* pData)
+{
+    if (!disposed) zephyr_tls_data = pData;
+}
 #else // _WIN32
