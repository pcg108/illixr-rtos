{
  "run_farm": {
    "base_recipe": "@RUN_RECIPE@",
    "recipe_arg_overrides": {
      "run_farm_tag": "xrsight-rtos",
      "default_platform": "XilinxAlveoU250InstanceDeployManager",
      "default_simulation_dir": "@SIM_DIR@",
      "default_fpga_db": "@FPGA_DB@",
      "run_farm_host_specs": [
        {
          "xrsight_one_board": {
            "num_fpgas": 1,
            "num_metasims": 0,
            "use_for_switch_only": 0
          }
        }
      ],
      "run_farm_hosts_to_use": [
        {
          "localhost": "xrsight_one_board"
        }
      ]
    }
  },
  "metasimulation": {
    "metasimulation_enabled": false,
    "metasimulation_host_simulator": "verilator",
    "metasimulation_only_plusargs": "",
    "metasimulation_only_vcs_plusargs": ""
  },
  "target_config": {
    "topology": "no_net_config",
    "no_net_num_nodes": 1,
    "link_latency": 6405,
    "switching_latency": 10,
    "net_bandwidth": 200,
    "profile_interval": 1000000,
    "default_hw_config": "@ALIAS@",
    "plusarg_passthrough": "+max-cycles=100000000000"
  },
  "tracing": {
    "enable": false,
    "output_format": 0,
    "selector": 1,
    "start": 0,
    "end": -1
  },
  "autocounter": {
    "read_rate": 0
  },
  "workload": {
    "workload_name": "@WORKLOAD_JSON@",
    "terminate_on_completion": false,
    "suffix_tag": null
  },
  "host_debug": {
    "zero_out_dram": true,
    "disable_synth_asserts": false
  },
  "synth_print": {
    "start": 0,
    "end": -1,
    "cycle_prefix": true
  }
}
